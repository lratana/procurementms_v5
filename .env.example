# Frontend API Base URL (same-origin /api or environment-specific Worker URL)
VITE_API_BASE_URL=/api

# Local Express Backend Configuration (Local Development Only)
NODE_ENV=development
PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=procurement_db
DB_USER=
DB_PASSWORD=

# Authentication Secret (Generate with: openssl rand -hex 32)
# Never commit real secrets. For Cloudflare Workers, use `wrangler secret put JWT_SECRET`
JWT_SECRET=
JWT_EXPIRES_IN=24h