# Frontend API base URL (Vite exposes VITE_* values to the browser)
# Production same-origin setup: https://YOUR_DOMAIN.com/api/*
VITE_API_BASE_URL=/api

# For local Express + Vite development, /api is also same-origin on localhost:3000.
# Never place JWT_SECRET, DB passwords, or Cloudflare tokens in VITE_* variables.
